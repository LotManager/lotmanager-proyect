// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Módulo: Geografía
// -----------------------------------------------------------------------------
model Provincia {
  id          Int         @id @default(autoincrement())
  nombre      String      @unique

  localidades Localidad[]
}

model Localidad {
  id            Int       @id @default(autoincrement())
  nombre        String
  codigoPostal  Int?      @map("codigo_postal")
  provinciaId   Int       @map("id_provincia")
  provincia     Provincia @relation(fields: [provinciaId], references: [id])
  feedlots      Feedlot[]
}

model Feedlot {
  id          Int       @id @default(autoincrement())
  nombre      String
  localidadId Int       @map("id_localidad")
  localidad   Localidad @relation(fields: [localidadId], references: [id])

  corrales    Corral[]
}

// -----------------------------------------------------------------------------
// Módulo: Usuarios y Personas
// -----------------------------------------------------------------------------

model Persona {
  id       Int      @id @default(autoincrement())
  nombre   String
  apellido String
  email    String  @unique

  usuario  Usuario?
}

model Usuario {
  id         Int     @id @default(autoincrement())
  username   String  @unique // Nombre claro
  contrasena String  // Contraseña hasheada
  rol TipoRol  

  personaId  Int     @unique    
  persona    Persona @relation(fields: [personaId], references: [id])
  
}

// -----------------------------------------------------------------------------
// Módulo: Instalaciones y Animales Base
// -----------------------------------------------------------------------------
model Corral {
  id              Int      @id @default(autoincrement())
  numero          Int      @unique
  capacidadMaxima Int      
  tipo            TipoCorral
  feedlot         Feedlot  @relation(fields: [feedlotId], references: [id])
  feedlotId       Int      @map("id_feedlot")

  bovinos             Bovino[]
  suministros         Suministro[]
  movimientosDesde    MovimientoCorral[] @relation("MovimientosDesdeCorral")
  movimientosHacia    MovimientoCorral[] @relation("MovimientosHaciaCorral")
}

model Raza {
  id      Int      @id @default(autoincrement())
  nombre  String   @unique

  bovinos Bovino[]
}

model Bovino {
  id              Int            @id @default(autoincrement())
  caravana        Int            @unique // Caravana suele ser única
  razaId          Int            @map("id_raza")
  raza            Raza           @relation(fields: [razaId], references: [id])
  corralId        Int            @map("id_corral")
  corral          Corral         @relation(fields: [corralId], references: [id])
  situacionBovino SituacionBovino // Renombrado de estado_bovino
  estadoSalud     EstadoSalud    @default(SANO)
  sexo            SexoBovino
  tipoBovino      TipoBovino
  ingreso         DateTime
  egreso          DateTime?
  pesoIngreso     Float          @map("peso_ingreso")
  pesoEgreso      Float?         @map("peso_egreso")

  pesajes         Pesaje[]
  movimientos     MovimientoCorral[]
  casosEnfermedad CasoEnfermedad[]
}

model Pesaje {
  id         Int      @id @default(autoincrement())
  bovinoId   Int      @map("id_bovino")
  bovino     Bovino   @relation(fields: [bovinoId], references: [id])
  fecha      DateTime @default(now()) @map("fechaPesaje") // Nombre más específico
  pesoActual Float    @map("pesoActual") // Nombre del diagrama de clases
}

// -----------------------------------------------------------------------------
// Módulo: Movimientos
// -----------------------------------------------------------------------------
model MovimientoCorral {
  id              Int        @id @default(autoincrement())
  bovinoId        Int        @map("id_bovino")
  bovino          Bovino     @relation(fields: [bovinoId], references: [id])
  corralOrigenId  Int       @map("id_corral_origen")
  corralOrigen    Corral    @relation("MovimientosDesdeCorral", fields: [corralOrigenId], references: [id])
  corralDestinoId Int        @map("id_corral_destino")
  corralDestino   Corral     @relation("MovimientosHaciaCorral", fields: [corralDestinoId], references: [id])
  fecha           DateTime   @default(now()) @map("fechaMovimiento") // Nombre más específico
  motivo          TipoMotivo
}

// -----------------------------------------------------------------------------
// Módulo: Alimentación
// -----------------------------------------------------------------------------
model Alimento {
  id            Int      @id @default(autoincrement())
  nombre        String
  tipo          TipoAlimento // Usamos el Enum

  detallesDieta DetalleDieta[]
}

model Dieta {
  id            Int      @id @default(autoincrement())
  nombre        String   @unique
  descripcion   String?

  detallesDieta DetalleDieta[]
  suministros   Suministro[]
}

model DetalleDieta {
  dietaId      Int
  dieta        Dieta    @relation(fields: [dietaId], references: [id])
  alimentoId   Int
  alimento     Alimento @relation(fields: [alimentoId], references: [id])
  proporcionKg Float    @map("proporcionKg") // Cantidad en KG

  @@id([dietaId, alimentoId])
}

model Suministro {
  id         Int      @id @default(autoincrement())
  dietaId    Int
  dieta      Dieta    @relation(fields: [dietaId], references: [id])
  corralId   Int
  corral     Corral   @relation(fields: [corralId], references: [id])
  cantidadKg Float    @map("cantidadKg") // Cantidad total en KG
  fecha      DateTime @default(now())
}
// -----------------------------------------------------------------------------
// Módulo: Sanidad Animal
// -----------------------------------------------------------------------------

model Enfermedad {
  id              Int              @id @default(autoincrement())
  nombre          String           @unique
  descripcion     String?
  tipo            TipoEnfermedad

  casosEnfermedad CasoEnfermedad[]
}

// Representa un TIPO de tratamiento o protocolo (ej: "Antibiótico X 10ml", "Vacuna Antirrábica")
model Tratamiento {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique // El nombre del protocolo/tipo de tratamiento
  descripcion String? // Descripción general del protocolo
  unidad      TipoUnidad // Unidad estándar para este tipo de tratamiento

  
  casosEnfermedad CasoEnfermedad[]
}

// Representa la instancia de un Bovino teniendo una Enfermedad (el "caso")
model CasoEnfermedad {
  id              Int        @id @default(autoincrement())
  bovinoId        Int        @map("id_bovino")
  bovino          Bovino     @relation(fields: [bovinoId], references: [id])
  enfermedadId    Int        @map("id_enfermedad")
  enfermedad      Enfermedad @relation(fields: [enfermedadId], references: [id])
  fechaDeteccion  DateTime   @map("fecha_deteccion")
  fechaAlta       DateTime?  @map("fecha_alta")

  tratamientoId   Int         @map("id_tratamiento")
  tratamiento     Tratamiento @relation(fields: [tratamientoId], references: [id])
}

// -----------------------------------------------------------------------------
// Definición de Enums
// -----------------------------------------------------------------------------
enum SituacionBovino {
  ENCORRAL
  EGRESADA
}

enum TipoCorral {
  ENGORDE
  ENFERMA
}

enum EstadoSalud {
  SANO
  ENFERMO
  FALLECIDO
}

enum TipoMotivo {
  ENFERMEDAD
  CAMBIO
}

enum TipoAlimento {
  GRANO
  FORRAJE
  SUPLEMENTO
}

enum TipoEnfermedad {
  RESPIRATORIA
  DIGESTIVA
  SISTEMA_NERVIOSO
  OJOS
  PARASITARIA
  INTOXICACION
  TRAUMATOLOGICA
  OTRA
}

enum TipoRol {
  ADMINISTRADOR
  ENCARGADO
}

enum SexoBovino {
  MACHO
  HEMBRA
}

enum TipoBovino {
  TERNERO
  NOVILLO
  VAQUILLONA
  DESCARTE
}

enum TipoUnidad {
  ML
  MG
  G
  TABLETA
  UNIDAD
}